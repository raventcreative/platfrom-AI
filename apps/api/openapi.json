  "info": {
    "title": "ProdPilot API",
    "description": "AIpreneur Content Engine — kontrak API v1 untuk web Next.js",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateBrandDto": {
        "type": "object",
        "properties": {
          "platforms": {
            "type": "array",
            "enum": [
              "instagram",
              "tiktok"
            ],
            "items": {
              "type": "string",
              "enum": [
                "instagram",
                "tiktok"
              ]
            }
          },
          "profile": {
            "type": "object",
            "description": "Jawaban intake lengkap + daftar SKU (profile.skus) — disimpan di Brand.profile.",
            "additionalProperties": true
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "niche": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "skincare",
              "fnb",
              "fashion",
              "service",
              "other"
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateBrandDto": {
        "type": "object",
        "properties": {
          "platforms": {
            "type": "array",
            "enum": [
              "instagram",
              "tiktok"
            ],
            "items": {
              "type": "string",
              "enum": [
                "instagram",
                "tiktok"
              ]
            }
          },
          "profile": {
            "type": "object",
            "additionalProperties": true
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "niche": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "skincare",
              "fnb",
              "fashion",
              "service",
              "other"
            ]
          }
        }
      },
      "CreateConversationDto": {
        "type": "object",
        "properties": {
          "brandId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "brandId"
        ]
      },
      "PostMessageDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "description": "Pilihan model dari UI. Kosong → pakai default server.",
            "enum": [
              "anthropic",
              "openai"
            ]
          }
        },
        "required": [
          "content"
        ]
      },
      "GenerateDto": {
        "type": "object",
        "properties": {
          "brandId": {
            "type": "string"
          },
          "agent": {
            "type": "string",
            "enum": [
              "SCRIPT",
              "CAROUSEL",
              "STORYBOARD",
              "CAPTION",
              "IDEAS"
            ]
          },
          "input": {
            "type": "string",
            "description": "Daily input yang sudah dirangkai dari form (boleh kosong → pakai profil brand)."
          },
          "provider": {
            "type": "string",
            "description": "Pilihan model dari UI. Kosong → default server.",
            "enum": [
              "anthropic",
              "openai"
            ]
          },
          "apiKey": {
            "type": "string",
            "description": "\"Bring your own key\" dari UI. Dikirim per-request, dipakai sekali, TIDAK\ndisimpan di server (lewat payload antrian, bukan kolom DB). Kosong → env."
          },
          "model": {
            "type": "string",
            "description": "Override model spesifik (mis. gpt-4o-mini / claude-opus-4-8). Kosong → default."
          }
        },
        "required": [
          "brandId",
          "agent"
        ]
      },
      "InsightDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "competitor",
              "ig_audit",
              "inspiration",
              "education",
              "content_intel",
              "ig_insight",
              "ig_research"
            ]
          },
          "brandId": {
            "type": "string",
            "description": "Konteks brand (opsional) — profilnya ikut dimasukkan ke prompt."
          },
          "params": {
            "type": "object",
            "description": "Parameter bebas per-tool (mis. handle IG, tema, topik)."
          },
          "provider": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai"
            ]
          },
          "apiKey": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      },
      "AutomateDto": {
        "type": "object",
        "properties": {
          "brandId": {
            "type": "string"
          },
          "brief": {
            "type": "string",
            "description": "Brief / arahan konten dari user (jadi dasar spec JSON).",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "description": "Bentuk output yang mau dibuat.",
            "enum": [
              "reels",
              "carousel",
              "post"
            ]
          },
          "platform": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai"
            ]
          },
          "apiKey": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "brief",
          "format"
        ]
      },
      "GenerateImageDto": {
        "type": "object",
        "properties": {
          "brandId": {
            "type": "string"
          },
          "brief": {
            "type": "string",
            "description": "Brief / arahan visual dari user.",
            "minLength": 1
          },
          "count": {
            "type": "number",
            "description": "Jumlah gambar/konsep yang dibuat (1–4, default 3).",
            "minimum": 1,
            "maximum": 4
          },
          "aspect": {
            "type": "string",
            "description": "Rasio gambar (default square).",
            "enum": [
              "square",
              "portrait",
              "landscape"
            ]
          },
          "style": {
            "type": "string",
            "description": "Gaya visual opsional (mis. \"flat vector\", \"fotografi produk\", \"3D render\")."
          },
          "apiKey": {
            "type": "string",
            "description": "BYO OpenAI key dari UI (image hanya via OpenAI); tidak disimpan."
          },
          "model": {
            "type": "string",
            "description": "Override model image (mis. dall-e-3 / gpt-image-1)."
          }
        },
        "required": [
          "brief"
        ]
      }
    }
  }
}