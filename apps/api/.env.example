DATABASE_URL=postgresql://prodpilot:prodpilot@localhost:5432/prodpilot
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=4000
WEB_ORIGIN=http://localhost:3000

# LLM (Content Engine).
# Pilih provider: "anthropic" (Claude) atau "openai" (ChatGPT).
# Kosongkan LLM_PROVIDER → auto: pakai Anthropic bila ada key-nya, jika tidak OpenAI.
# Kosongkan kedua API key → "mode demo" (output statis tanpa panggil API).
LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=2000

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
