DATABASE_URL=postgresql://prodpilot:prodpilot@localhost:5432/prodpilot
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=4000
WEB_ORIGIN=http://localhost:3000

# LLM (Content Engine). Kosongkan ANTHROPIC_API_KEY untuk pakai "mode demo".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2000

# Scraping Instagram via Apify (untuk "training" brand voice dari IG handle).
# Kosongkan APIFY_TOKEN untuk nonaktif — bisa tetap latih voice dgn contoh caption manual.
APIFY_TOKEN=
APIFY_IG_ACTOR=apify~instagram-profile-scraper
IG_POSTS_LIMIT=12
