generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────
enum OrgPlan {
  AGENCY
  SAAS
}

enum UserRole {
  OWNER
  EDITOR
  VIEWER
}

enum Platform {
  INSTAGRAM
  TIKTOK
}

enum VoiceStatus {
  DRAFT
  READY
}

enum BrandCategory {
  SKINCARE
  FNB
  FASHION
  SERVICE
  OTHER
}

enum JobAgent {
  // MVP — Content Engine generators
  SCRIPT
  CAROUSEL
  STORYBOARD
  CAPTION
  IDEAS
  BRANDVOICE
  // Fase 2+
  RESEARCH
  STRATEGY
  VIDEO
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

// ── Tenant & user ────────────────────────────────────────────────
model Organization {
  id        String   @id @default(uuid())
  name      String
  plan      OrgPlan  @default(AGENCY)
  users     User[]
  brands    Brand[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String       @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String       @unique
  name      String
  role      UserRole     @default(OWNER)
  apiToken  String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orgId])
}

// ── Brand (workspace) ────────────────────────────────────────────
model Brand {
  id            String             @id @default(uuid())
  orgId         String
  org           Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  niche         String?
  description   String?
  category      BrandCategory      @default(OTHER)
  platforms     Platform[]
  profile       Json?              // jawaban intake (modul per vertikal)
  status        String             @default("active")
  voiceProfile  BrandVoiceProfile?
  kit           BrandKit?
  competitors   Competitor[]
  conversations Conversation[]
  jobs          Job[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([orgId])
}

model BrandVoiceProfile {
  id             String      @id @default(uuid())
  brandId        String      @unique
  brand          Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  toneAttributes String[]
  styleSummary   String?
  preferredWords String[]
  avoidWords     String[]
  status         VoiceStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model BrandKit {
  id         String   @id @default(uuid())
  brandId    String   @unique
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  logoUrl    String?
  colors     String[]
  fonts      String[]
  guidelines String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Competitor {
  id        String   @id @default(uuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  handle    String
  platform  Platform
  notes     String?
  createdAt DateTime @default(now())

  @@index([brandId])
}

// ── Chat shell ───────────────────────────────────────────────────
model Conversation {
  id        String    @id @default(uuid())
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title     String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([brandId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  jobId          String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ── Async job tracking ───────────────────────────────────────────
model Job {
  id          String    @id @default(uuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  agent       JobAgent
  status      JobStatus @default(QUEUED)
  input       Json
  output      Json?
  error       String?
  costCredits Int?
  tokensUsed  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([brandId])
}
